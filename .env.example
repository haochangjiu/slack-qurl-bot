# Slack Bot Credentials (optional if using Discord)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Discord Bot Token (optional if using Slack)
# DISCORD_TOKEN=your-discord-bot-token

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key

# LayerV API
LAYERV_API_URL=https://api.layerv.xyz
LAYERV_API_KEY=your-layerv-api-key
LAYERV_STATS_URL=https://layerv.ai/qurl/dashboard

# QURL Default Settings
QURL_DEFAULT_EXPIRES_IN=30m

# Slack web summary
# WEB_SUMMARY_ENABLED=true
# WEB_SUMMARY_MODEL=claude-3-haiku-20240307
# WEB_SUMMARY_TIMEOUT_SECONDS=15
# WEB_SUMMARY_MAX_BYTES=750000
# WEB_SUMMARY_MAX_CHARS=12000
# WEB_SUMMARY_MAX_REDIRECTS=3

# Encryption secret for storing user API keys (change this in production!)
ENCRYPTION_SECRET=your-random-secret-string

# File upload API (optional, for Discord file upload feature)
# UPLOAD_API_URL=http://localhost:8080

# Google Maps Embed API key (for converting goo.gl short links to stable embed URLs)
# GOOGLE_MAPS_EMBED_API_KEY=your-google-maps-embed-api-key

# Mint link API (address before /{resource_id})
# MINT_LINK_API_URL=https://get.qurl.link/api/mint_link
